{
    "extends": "./tsconfig.json",
    "compilerOptions": {
      "target": "ES2020",
      "lib": ["ES2020"],
      "module": "ES2020",
      "moduleResolution": "node",
      "types": ["@cloudflare/workers-types"],
      "allowSyntheticDefaultImports": true,
      "skipLibCheck": true,
      "isolatedModules": true,
      "noEmit": true
    },
    "include": ["worker/**/*.ts", "cloudflare.d.ts"]
  }